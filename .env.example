# ---------------------------------------------------------------------------
# BrandShield AI — environment variables
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Leave blank to use a local SQLite file (good for development).
# For production use your Supabase Postgres connection string:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- LLM (Groq) ------------------------------------------------------------
# Server-side only. Never expose this key to the browser.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_TIMEOUT_SECONDS=25

# --- Supabase (optional: real auth + private storage) ----------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=brand-docs

# --- App -------------------------------------------------------------------
# Comma-separated list of allowed origins. Use your deployed frontend URL.
CORS_ORIGINS=*
DEMO_WORKSPACE_SLUG=northwind-foods
SEED_ON_START=true

# --- Frontend (Vite) -------------------------------------------------------
# Only needed when the API is on a different origin than the frontend.
# Leave blank in local dev; Vite proxies /api to the backend.
VITE_API_URL=
