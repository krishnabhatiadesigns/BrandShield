# Leave DATABASE_URL blank to use the local SQLite database.
DATABASE_URL=

# Optional. Deterministic brand checks still run without an API key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=25

# Comma-separated explicit origins; wildcard origins are rejected.
# Set this to the deployed frontend's exact origin in production.
CORS_ORIGINS=http://localhost:5173
DEMO_WORKSPACE_SLUG=northwind-foods
DEMO_SESSION_TTL_HOURS=12
SEED_ON_START=true
