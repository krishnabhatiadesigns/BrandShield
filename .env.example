# Leave DATABASE_URL blank to use the local SQLite database.
DATABASE_URL=

# Optional. Deterministic brand checks still run without an API key.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=25

# Comma-separated explicit origins; wildcard origins are rejected.
# Set this to the deployed frontend's exact origin in production.
CORS_ORIGINS=http://localhost:5173
DEMO_WORKSPACE_SLUG=northwind-foods
DEMO_SESSION_TTL_HOURS=12
SEED_ON_START=true
# Anonymous persona access to the fictional demo workspace.
DEMO_AUTH_ENABLED=true

# Supabase Auth backend. Keep the service-role key and legacy JWT secret private.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
APP_FRONTEND_URL=http://localhost:5173
ALLOW_ORGANIZATION_CREATION=true

# Private source and creative-asset storage.
STORAGE_BACKEND=local
PRIVATE_STORAGE_DIR=
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Durable email outbox. The worker sends SMTP messages and retries failures.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=BrandShield <no-reply@brandshield.local>
SMTP_USE_TLS=true
NOTIFICATION_WORKER_ENABLED=false

# Frontend build-time feature flags.
# Set false only to hide the public demo role selector.
VITE_DEMO_AUTH_ENABLED=true
# VITE_ORGANIZATION_CREATION_ENABLED=true
